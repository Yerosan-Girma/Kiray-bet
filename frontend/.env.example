# Backend API URL (Render deployment URL)
# Example: https://rental-house-backend.onrender.com/api
VITE_API_URL=https://your-backend-api.onrender.com/api

# Google Sign-In Client ID (from Google Cloud Console)
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
